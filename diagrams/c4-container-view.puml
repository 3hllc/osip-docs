@startuml c4-container-view
!include <C4/C4_Container>
title OSIP - Site-local Edge Runtime Containers (C4 Level 2)
top to bottom direction

Person(occupant, "Occupant / operator")
System_Boundary(edge, "OSIP Edge Runtime at one site") {
  Container(ui, "Local application API and experience", "Web/mobile/voice clients", "Presents state, explanations, manual controls, and policy-scoped intents.")
  Container(twin, "Digital twin and asset registry", "Platform service", "Owns site, space, asset, capability, binding, relationship, state, and provenance projections.")
  Container(policy, "Policy engine", "Platform service", "Evaluates authorization, safety, access, energy, and approval constraints.")
  Container(reasoning, "Constrained Spatial Reasoning Layer", "Platform service", "Interprets spatial context and intent under policy, safety, privacy, energy, and authorization constraints; produces explainable plans.")
  Container(execution, "Deterministic execution", "Platform service", "Runs approved plans, narrow local rules and schedules, command verification, and conservative failure behaviour.")
  Container(bus, "Canonical OSIP bus", "Selected local transport", "Carries canonical events and routed commands independently of provider transport.")
  Container(provider, "Integration providers", "Home Assistant provider and direct providers", "Map external endpoints to bindings, capabilities, canonical events/commands, health, and diagnostics.")
  ContainerDb(state, "Local state, configuration, and audit", "Database", "Stores approved configuration, projections, plans, and durable evidence.")
}
System_Ext(devices, "Devices and external systems", "Protocols, bridges, and provider endpoints")
System_Ext(control, "OSIP Fleet / Control Plane", "Optional configuration, rollout, health, and support")
System_Ext(ai, "AI services", "Optional recommendations and intent interpretation")

Rel(occupant, ui, "Uses")
Rel(ui, twin, "Queries state and explanations")
Rel(ui, reasoning, "Submits policy-scoped intents")
Rel(twin, policy, "Provides scoped state and relationships")
Rel(twin, reasoning, "Provides spatial/context evidence")
Rel(policy, reasoning, "Permits, denies, or requires approval")
Rel(reasoning, execution, "Approved execution plan")
Rel(execution, bus, "Canonical commands and events")
Rel(bus, twin, "Canonical events")
Rel(provider, bus, "Canonical events, commands, and health")
Rel(provider, devices, "Provider/protocol traffic")
Rel(twin, state, "Reads/writes projections")
Rel(policy, state, "Reads policies and records decisions")
Rel(reasoning, state, "Reads bindings and records plans")
Rel(execution, state, "Records execution and audit")
Rel(control, state, "Distributes/reconciles versioned configuration")
Rel(ai, reasoning, "Suggested intent or interpretation", "optional and policy-controlled")
@enduml
