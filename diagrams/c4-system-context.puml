@startuml c4-system-context
!include <C4/C4_Context>
title OSIP - Operational Control Plane for Physical Spaces (C4 Level 1)
top to bottom direction

Person(occupant, "Occupant / tenant", "Uses and supervises the physical environment.")
Person(operator, "Installer / operator", "Commissions, services, and diagnoses supported sites.")
System(edge, "OSIP Edge Runtime", "Site-local spatial/asset model, canonical bus, policy, deterministic automation, and controlled execution.")
System(control, "OSIP Fleet / Control Plane", "Optional multi-site configuration, rollout, health, audit, and support plane; not in a critical local loop.")
System_Ext(devices, "Physical devices and engineering systems", "Sensors, actuators, HVAC, locks, safety systems, and robots.")
System_Ext(providers, "Integration providers", "Home Assistant, Zigbee2MQTT/MQTT, BACnet, KNX, Modbus, and vendor APIs. Replaceable infrastructure.")
System_Ext(applications, "OSIP applications", "Operator, tenant, installer, and vertical applications using OSIP semantics.")
System_Ext(cloud, "Optional cloud and AI services", "Approved remote access, backup, analytics, fleet services, and optional inference.")
System_Ext(ai, "Approved AI providers", "Local or cloud inference for optional assistance and reasoning.")

Rel(occupant, applications, "Uses and retains manual control")
Rel(operator, control, "Commissions and operates", "authenticated tools")
Rel(applications, edge, "Policy-scoped queries, intents, and commands")
Rel(devices, providers, "Protocol traffic")
Rel(providers, edge, "Canonical events, commands, health, and diagnostics")
Rel(control, edge, "Versioned configuration, policy, rollout, and audit sync")
Rel(edge, cloud, "Opt-in enhancement", "outbound, least privilege")
Rel(edge, ai, "Optional context and recommendations", "policy-controlled")
@enduml
